# Render web service + Supabase production template. Set real values only in
# Render's Environment dashboard; do not commit a filled-in copy of this file.
APP_NAME=IsdaLog
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-ISDALOG-WEB.onrender.com

# From Supabase Dashboard -> Connect -> Session pooler.
# Copy the host and username exactly; do not construct them manually.
DB_CONNECTION=pgsql
DB_HOST=YOUR-POOLER-HOST.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_SUPABASE_PROJECT_REF
DB_PASSWORD=    
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Create a second Render Web Service for Reverb. It must be publicly reachable
# by browser clients over HTTPS.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=YOUR-REVERB-SERVICE.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=10000
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Supabase Storage S3 credentials, generated/rotated in Supabase Storage.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=YOUR_SUPABASE_REGION
AWS_BUCKET=catches
AWS_ENDPOINT=https://YOUR_SUPABASE_PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/storage/v1/object/public/catches

LOG_CHANNEL=stderr
LOG_LEVEL=warning
VITE_APP_NAME="${APP_NAME}"

# Demo funding is permitted only in local/testing; no live adapter exists.
FUNDING_DRIVER=disabled
# SMS log is a simulation only; disabled outside local/testing.
SMS_DRIVER=disabled
