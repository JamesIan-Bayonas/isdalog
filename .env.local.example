# Local development with XAMPP MySQL/MariaDB: no cloud credentials required.
APP_NAME=IsdaLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isdalog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=isdalog-local
REVERB_APP_KEY=isdalog-local-key
REVERB_APP_SECRET=replace-with-a-local-random-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=debug
VITE_APP_NAME="${APP_NAME}"

# Demo funding is permitted only in local/testing; no live adapter exists.
FUNDING_DRIVER=demo
# SMS log is a simulation only; disabled outside local/testing.
SMS_DRIVER=disabled
